\n        // whole deferral: the app scrolls programmatically as it renders\n        // (MediaSlider calls scrollTo on its track), and a browser-generated\n        // scroll is a TRUSTED event, so `isTrusted` cannot tell it apart from a\n        // real one. Lighthouse never touches the page, yet the pixel was still\n        // firing at 886ms instead of waiting for the 4s fallback. `wheel` covers\n        // desktop scrolling and `touchstart` covers mobile, both of which only\n        // a person can produce.\n        var EVENTS = ['pointerdown', 'keydown', 'wheel', 'touchstart'];\n        var started = false;\n        var start = function () {\n          if (started) return;\n          started = true;\n          EVENTS.forEach(function (e) {\n            window.removeEventListener(e, start, true);\n          });\n          ttq.load('D7UB3GRC77U0A0BNDNI0');\n          ttq.page();\n        };\n\n        window.addEventListener('load', function () {\n          EVENTS.forEach(function (e) {\n            window.addEventListener(e, start, { capture: true, passive: true });\n          });\n          window.setTimeout(start, FALLBACK_MS);\n        });\n      }(window, document, 'ttq');\n    </script>\n    <!-- TikTok Pixel Code End -->\n    <script type=\"module\" crossorigin src=\"/assets/index-BRjOKfRh.js\"></script>\n    <link rel=\"stylesheet\" crossorigin href=\"/assets/index-CzIECtyk.css\">\n  </head>\n  <body>\n    <div id=\"root\"></div>\n  </body>\n</html>\n",
