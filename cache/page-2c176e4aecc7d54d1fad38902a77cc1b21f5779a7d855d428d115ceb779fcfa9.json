{
  "citation_url": "https://faq.goldenscent.com/en/faqs/delivery.html?utm_source=openai",
  "html": "<!doctype html>\n<html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0,  minimal-ui, maximum-scale=1.0,user-scalable=no\">\n    <title>Golden Scent FAQ - Delivery & Pick Up</title>\n    <script src=\"/assets/js/main.js\"></script>\n    <link rel=\"stylesheet\" href=\"/assets/css/styles.css\">\n    <link rel=\"icon\" href=\"/assets/icons/favicon.ico\" type=\"image/png\" sizes=\"32x32\">\n</head>\n<body class=\"faqs_body en\">\n  <header class=\"logoc\">\n  <div class=\"lang-switch\"><nav>\n<!-- pages -->\n\n    <!--page mapping: {\"en\"=>{\"path\"=>\"en/index.html\", \"title\"=>\"FAQ\", \"icon\"=>\"favicon\", \"is_home\"=>true}, \"ar\"=>{\"path\"=>\"index.html\", \"title\"=>\"FAQ\", \"icon\"=>\"favicon\", \"is_home\"=>true}}-->\n    <!--current lang:en-->\n    \n    <!--item: {\"path\"=>\"en/index.html\", \"title\"=>\"FAQ\", \"icon\"=>\"favicon\", \"is_home\"=>true}-->\n    <!--current path: en/faqs/delivery.html-->\n    \n\n    <!--page mapping: {\"en\"=>{\"path\"=>\"en/faqs/delivery.html\", \"title\"=>\"Delivery & Pick Up\", \"icon\"=>\"delivery\"}, \"ar\"=>{\"path\"=>\"ar/faqs/delivery.html\", \"title\"=>\"التوصيل والاستلام\", \"icon\"=>\"delivery\"}}-->\n    <!--current lang:en-->\n    \n    <!--item: {\"path\"=>\"en/faqs/delivery.html\", \"title\"=>\"Delivery & Pick Up\", \"icon\"=>\"delivery\"}-->\n    <!--current path: en/faqs/delivery.html-->\n    \n        <!-- current page -->\n        \n            <!--translations: en{\"path\"=>\"en/faqs/delivery.html\", \"title\"=>\"Delivery & Pick Up\", \"icon\"=>\"delivery\"}-->\n            \n            <!--path from map: en/faqs/delivery.html-->\n            \n            \n                <!--item2 : en/faqs/delivery.html-->\n                \n                    <a hreflang=\"en\" class=\"active\">English</a>\n                \n            \n        \n            <!--translations: ar{\"path\"=>\"ar/faqs/delivery.html\", \"title\"=>\"التوصيل والاستلام\", \"icon\"=>\"delivery\"}-->\n            \n            <!--path from map: ar/faqs/delivery.html-->\n            \n            \n                <!--item2 : ar/faqs/delivery.html-->\n                \n                    <a hreflang=\"ar\" href=\"/ar/faqs/delivery.html\">العربية</a>\n                \n            \n        \n    \n\n    <!--page mapping: {\"en\"=>{\"path\"=>\"en/faqs/order-statuses.html\", \"title\"=>\"Order Statuses\", \"icon\"=>\"order-statuses\"}, \"ar\"=>{\"path\"=>\"ar/faqs/order-statuses.html\", \"title\"=>\"حالات الطلب\", \"icon\"=>\"order-statuses\"}}-->\n    <!--current lang:en-->\n    \n    <!--item: {\"path\"=>\"en/faqs/order-statuses.html\", \"title\"=>\"Order Statuses\", \"icon\"=>\"order-statuses\"}-->\n    <!--current path: en/faqs/delivery.html-->\n    \n\n    <!--page mapping: {\"en\"=>{\"path\"=>\"en/faqs/return-policy.html\", \"title\"=>\"Return Policy\", \"icon\"=>\"return-policy\"}, \"ar\"=>{\"path\"=>\"ar/faqs/return-policy.html\", \"title\"=>\"سياسة الإستبدال\", \"icon\"=>\"return-policy\"}}-->\n    <!--current lang:en-->\n    \n    <!--item: {\"path\"=>\"en/faqs/return-policy.html\", \"title\"=>\"Return Policy\", \"icon\"=>\"return-policy\"}-->\n    <!--current path: en/faqs/delivery.html-->\n    \n\n    <!--page mapping: {\"en\"=>{\"path\"=>\"en/faqs/products.html\", \"title\"=>\"Products\", \"icon\"=>\"products\"}, \"ar\"=>{\"path\"=>\"ar/faqs/products.html\", \"title\"=>\"المنتجات\", \"icon\"=>\"products\"}}-->\n    <!--current lang:en-->\n    \n    <!--item: {\"path\"=>\"en/faqs/products.html\", \"title\"=>\"Products\", \"icon\"=>\"products\"}-->\n    <!--current path: en/faqs/delivery.html-->\n    \n\n    <!--page mapping: {\"en\"=>{\"path\"=>\"en/faqs/payment-methods.html\", \"title\"=>\"Payment Methods\", \"icon\"=>\"payment-methods\"}, \"ar\"=>{\"path\"=>\"ar/faqs/payment-methods.html\", \"title\"=>\"وسائل الدفع\", \"icon\"=>\"payment-methods\"}}-->\n    <!--current lang:en-->\n    \n    <!--item: {\"path\"=>\"en/faqs/payment-methods.html\", \"title\"=>\"Payment Methods\", \"icon\"=>\"payment-methods\"}-->\n    <!--current path: en/faqs/delivery.html-->\n    \n\n    <!--page mapping: {\"en\"=>{\"path\"=>\"en/faqs/wallet.html\", \"title\"=>\"Cashback\", \"icon\"=>\"wallet\"}, \"ar\"=>{\"path\"=>\"ar/faqs/wallet.html\", \"title\"=>\"الاسترجاع النقدي (كاش باك)\", \"icon\"=>\"wallet\"}}-->\n    <!--current lang:en-->\n    \n    <!--item: {\"path\"=>\"en/faqs/wallet.html\", \"title\"=>\"Cashback\", \"icon\"=>\"wallet\"}-->\n    <!--current path: en/faqs/delivery.html-->\n    \n\n    <!--page mapping: {\"en\"=>{\"path\"=>\"en/faqs/vouchers.html\", \"title\"=>\"Vouchers & E-Gift Cards\", \"icon\"=>\"vouchers\"}, \"ar\"=>{\"path\"=>\"ar/faqs/vouchers.html\", \"title\"=>\"القسائم وبطاقات الهدايا الإلكترونية\", \"icon\"=>\"vouchers\"}}-->\n    <!--current lang:en-->\n    \n    <!--item: {\"path\"=>\"en/faqs/vouchers.html\", \"title\"=>\"Vouchers & E-Gift Cards\", \"icon\"=>\"vouchers\"}-->\n    <!--current path: en/faqs/delivery.html-->\n    \n\n    <!--page mapping: {\"en\"=>{\"path\"=>\"en/faqs/shopping.html\", \"title\"=>\"Shopping & Security\", \"icon\"=>\"shopping-and-security\"}, \"ar\"=>{\"path\"=>\"ar/faqs/shopping.html\", \"title\"=>\"التسوق والدعم التقني\", \"icon\"=>\"shopping-and-security\"}}-->\n    <!--current lang:en-->\n    \n    <!--item: {\"path\"=>\"en/faqs/shopping.html\", \"title\"=>\"Shopping & Security\", \"icon\"=>\"shopping-and-security\"}-->\n    <!--current path: en/faqs/delivery.html-->\n    \n\n    <!--page mapping: {\"en\"=>{\"path\"=>\"en/faqs/vat.html\", \"title\"=>\"Value Added Tax (VAT)\", \"icon\"=>\"vat\"}, \"ar\"=>{\"path\"=>\"ar/faqs/vat.html\", \"title\"=>\"ضريبة القيمة المضافة\", \"icon\"=>\"vat\"}}-->\n    <!--current lang:en-->\n    \n    <!--item: {\"path\"=>\"en/faqs/vat.html\", \"title\"=>\"Value Added Tax (VAT)\", \"icon\"=>\"vat\"}-->\n    <!--current path: en/faqs/delivery.html-->\n    \n\n    <!--page mapping: {\"en\"=>{\"path\"=>\"en/faqs/about-fragrances.html\", \"title\"=>\"All About Fragrances\", \"icon\"=>\"all-about-fragrances\"}, \"ar\"=>{\"path\"=>\"ar/faqs/about-fragrances.html\", \"title\"=>\"عن العطور\", \"icon\"=>\"all-about-fragrances\"}}-->\n    <!--current lang:en-->\n    \n    <!--item: {\"path\"=>\"en/faqs/about-fragrances.html\", \"title\"=>\"All About Fragrances\", \"icon\"=>\"all-about-fragrances\"}-->\n    <!--current path: en/faqs/delivery.html-->\n    \n\n    <!--page mapping: {\"en\"=>{\"path\"=>\"en/faqs/global.html\", \"title\"=>\"Global\", \"icon\"=>\"global\"}, \"ar\"=>{\"path\"=>\"ar/faqs/global.html\", \"title\"=>\"بقية انحاء العالم\", \"icon\"=>\"global\"}}-->\n    <!--current lang:en-->\n    \n    <!--item: {\"path\"=>\"en/faqs/global.html\", \"title\"=>\"Global\", \"icon\"=>\"global\"}-->\n    <!--current path: en/faqs/delivery.html-->\n    \n\n</nav></div>\n  <div class=\"container\">\n    <div class=\"row\">\n      <div class=\"col-xs-12\">\n        <a href=\"https://www.goldenscent.com/en/\">\n          <img src=\"/assets/images/logo-en.svg\" alt=\"GoldenScent logo\">\n        </a>\n      </div>\n    </div>\n  </div>\n</header>\n\n<div class=\"row\">\n    <div class=\"col-xs-12 col-md-3 navigation-wrapper hidden-xs hidden-sm\">\n    <nav>\n        <div class=\"row\">\n            <!-- pages -->\n            \n                <!--page mapping: {\"en\"=>{\"path\"=>\"en/index.html\", \"title\"=>\"FAQ\", \"icon\"=>\"favicon\", \"is_home\"=>true}, \"ar\"=>{\"path\"=>\"index.html\", \"title\"=>\"FAQ\", \"icon\"=>\"favicon\", \"is_home\"=>true}}-->\n                <!--current lang:en-->\n                \n                <!--item: {\"path\"=>\"en/index.html\", \"title\"=>\"FAQ\", \"icon\"=>\"favicon\", \"is_home\"=>true}-->\n                \n                    \n                \n            \n                <!--page mapping: {\"en\"=>{\"path\"=>\"en/faqs/delivery.html\", \"title\"=>\"Delivery & Pick Up\", \"icon\"=>\"delivery\"}, \"ar\"=>{\"path\"=>\"ar/faqs/delivery.html\", \"title\"=>\"التوصيل والاستلام\", \"icon\"=>\"delivery\"}}-->\n                <!--current lang:en-->\n                \n                <!--item: {\"path\"=>\"en/faqs/delivery.html\", \"title\"=>\"Delivery & Pick Up\", \"icon\"=>\"delivery\"}-->\n                \n                    <div class=\"col-xs-12\">\n                        <a href=\"/en/faqs/delivery.html\" >Delivery & Pick Up</a>\n                    </div>\n                \n            \n                <!--page mapping: {\"en\"=>{\"path\"=>\"en/faqs/order-statuses.html\", \"title\"=>\"Order Statuses\", \"icon\"=>\"order-statuses\"}, \"ar\"=>{\"path\"=>\"ar/faqs/order-statuses.html\", \"title\"=>\"حالات الطلب\", \"icon\"=>\"order-statuses\"}}-->\n                <!--current lang:en-->\n                \n                <!--item: {\"path\"=>\"en/faqs/order-statuses.html\", \"title\"=>\"Order Statuses\", \"icon\"=>\"order-statuses\"}-->\n                \n                    <div class=\"col-xs-12\">\n                        <a href=\"/en/faqs/order-statuses.html\" >Order Statuses</a>\n                    </div>\n                \n            \n                <!--page mapping: {\"en\"=>{\"path\"=>\"en/faqs/return-policy.html\", \"title\"=>\"Return Policy\", \"icon\"=>\"return-policy\"}, \"ar\"=>{\"path\"=>\"ar/faqs/return-policy.html\", \"title\"=>\"سياسة الإستبدال\", \"icon\"=>\"return-policy\"}}-->\n                <!--current lang:en-->\n                \n                <!--item: {\"path\"=>\"en/faqs/return-policy.html\", \"title\"=>\"Return Policy\", \"icon\"=>\"return-policy\"}-->\n                \n                    <div class=\"col-xs-12\">\n                        <a href=\"/en/faqs/return-policy.html\" >Return Policy</a>\n                    </div>\n                \n            \n                <!--page mapping: {\"en\"=>{\"path\"=>\"en/faqs/products.html\", \"title\"=>\"Products\", \"icon\"=>\"products\"}, \"ar\"=>{\"path\"=>\"ar/faqs/products.html\", \"title\"=>\"المنتجات\", \"icon\"=>\"products\"}}-->\n                <!--current lang:en-->\n                \n                <!--item: {\"path\"=>\"en/faqs/products.html\", \"title\"=>\"Products\", \"icon\"=>\"products\"}-->\n                \n                    <div class=\"col-xs-12\">\n                        <a href=\"/en/faqs/products.html\" >Products</a>\n                    </div>\n                \n            \n                <!--page mapping: {\"en\"=>{\"path\"=>\"en/faqs/payment-methods.html\", \"title\"=>\"Payment Methods\", \"icon\"=>\"payment-methods\"}, \"ar\"=>{\"path\"=>\"ar/faqs/payment-methods.html\", \"title\"=>\"وسائل الدفع\", \"icon\"=>\"payment-methods\"}}-->\n                <!--current lang:en-->\n                \n                <!--item: {\"path\"=>\"en/faqs/payment-methods.html\", \"title\"=>\"Payment Methods\", \"icon\"=>\"payment-methods\"}-->\n                \n                    <div class=\"col-xs-12\">\n                        <a href=\"/en/faqs/payment-methods.html\" >Payment Methods</a>\n                    </div>\n                \n            \n                <!--page mapping: {\"en\"=>{\"path\"=>\"en/faqs/wallet.html\", \"title\"=>\"Cashback\", \"icon\"=>\"wallet\"}, \"ar\"=>{\"path\"=>\"ar/faqs/wallet.html\", \"title\"=>\"الاسترجاع النقدي (كاش باك)\", \"icon\"=>\"wallet\"}}-->\n                <!--current lang:en-->\n                \n                <!--item: {\"path\"=>\"en/faqs/wallet.html\", \"title\"=>\"Cashback\", \"icon\"=>\"wallet\"}-->\n                \n                    <div class=\"col-xs-12\">\n                        <a href=\"/en/faqs/wallet.html\" >Cashback</a>\n                    </div>\n                \n            \n                <!--page mapping: {\"en\"=>{\"path\"=>\"en/faqs/vouchers.html\", \"title\"=>\"Vouchers & E-Gift Cards\", \"icon\"=>\"vouchers\"}, \"ar\"=>{\"path\"=>\"ar/faqs/vouchers.html\", \"title\"=>\"القسائم وبطاقات الهدايا الإلكترونية\", \"icon\"=>\"vouchers\"}}-->\n                <!--current lang:en-->\n                \n                <!--item: {\"path\"=>\"en/faqs/vouchers.html\", \"title\"=>\"Vouchers & E-Gift Cards\", \"icon\"=>\"vouchers\"}-->\n                \n                    <div class=\"col-xs-12\">\n                        <a href=\"/en/faqs/vouchers.html\" >Vouchers & E-Gift Cards</a>\n                    </div>\n                \n            \n                <!--page mapping: {\"en\"=>{\"path\"=>\"en/faqs/shopping.html\", \"title\"=>\"Shopping & Security\", \"icon\"=>\"shopping-and-security\"}, \"ar\"=>{\"path\"=>\"ar/faqs/shopping.html\", \"title\"=>\"التسوق والدعم التقني\", \"icon\"=>\"shopping-and-security\"}}-->\n                <!--current lang:en-->\n                \n                <!--item: {\"path\"=>\"en/faqs/shopping.html\", \"title\"=>\"Shopping & Security\", \"icon\"=>\"shopping-and-security\"}-->\n                \n                    <div class=\"col-xs-12\">\n                        <a href=\"/en/faqs/shopping.html\" >Shopping & Security</a>\n                    </div>\n                \n            \n                <!--page mapping: {\"en\"=>{\"path\"=>\"en/faqs/vat.html\", \"title\"=>\"Value Added Tax (VAT)\", \"icon\"=>\"vat\"}, \"ar\"=>{\"path\"=>\"ar/faqs/vat.html\", \"title\"=>\"ضريبة القيمة المضافة\", \"icon\"=>\"vat\"}}-->\n                <!--current lang:en-->\n                \n                <!--item: {\"path\"=>\"en/faqs/vat.html\", \"title\"=>\"Value Added Tax (VAT)\", \"icon\"=>\"vat\"}-->\n                \n                    <div class=\"col-xs-12\">\n                        <a href=\"/en/faqs/vat.html\" >Value Added Tax (VAT)</a>\n                    </div>\n                \n            \n                <!--page mapping: {\"en\"=>{\"path\"=>\"en/faqs/about-fragrances.html\", \"title\"=>\"All About Fragrances\", \"icon\"=>\"all-about-fragrances\"}, \"ar\"=>{\"path\"=>\"ar/faqs/about-fragrances.html\", \"title\"=>\"عن العطور\", \"icon\"=>\"all-about-fragrances\"}}-->\n                <!--current lang:en-->\n                \n                <!--item: {\"path\"=>\"en/faqs/about-fragrances.html\", \"title\"=>\"All About Fragrances\", \"icon\"=>\"all-about-fragrances\"}-->\n                \n                    <div class=\"col-xs-12\">\n                        <a href=\"/en/faqs/about-fragrances.html\" >All About Fragrances</a>\n                    </div>\n                \n            \n                <!--page mapping: {\"en\"=>{\"path\"=>\"en/faqs/global.html\", \"title\"=>\"Global\", \"icon\"=>\"global\"}, \"ar\"=>{\"path\"=>\"ar/faqs/global.html\", \"title\"=>\"بقية انحاء العالم\", \"icon\"=>\"global\"}}-->\n                <!--current lang:en-->\n                \n                <!--item: {\"path\"=>\"en/faqs/global.html\", \"title\"=>\"Global\", \"icon\"=>\"global\"}-->\n                \n                    <div class=\"col-xs-12\">\n                        <a href=\"/en/faqs/global.html\" >Global</a>\n                    </div>\n                \n            \n        </div>\n    </nav>\n</div>\n\n<div class=\"navigation-wrapper-mobile hidden-md hidden-lg hidden-xl\">\n    <div class=\"\">\n        <a href=\"/en/index.html\">FAQ</a> <span> / Delivery & Pick Up</span>\n    </div>\n</div>\n\n    <div class=\"col-xs-12 col-md-9\">\n        \n            <div class=\"block-wrapper\">\n                <div class=\"row\">\n                    <div class=\"col-xs-12\">\n                        <H2>Home Delivery</h2>\n                    </div>\n                    \n    \n    <style>\n        \n        ul.jekyllcodex_accordion {position: relative;}\n        ul.jekyllcodex_accordion li { list-style: none;}\n        ul.jekyllcodex_accordion li input {display: none;}\n        ul.jekyllcodex_accordion li label {display: block; cursor: pointer; }\n        ul.jekyllcodex_accordion li div {display: none;}\n\n        /*\n         * When chekcing the input inside of the li, we make the div display:block to show the content\n         */\n        ul.jekyllcodex_accordion li input:checked + label {}\n        ul.jekyllcodex_accordion li input:checked + label + div {display: block;}\n        \n    </style>\n\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-1-where-do-you-deliver-to\" type=\"checkbox\" />\n                    <label for=\"accordion-1-where-do-you-deliver-to\">Where do you deliver to?</label>\n                    <div><p>We now deliver across the Gulf! <br /><br /> You can now choose your favorite items, and enjoy our delivery to your doorstep at your home or office in the KSA, Kuwait, UAE and Oman.<br /><br />We can also deliver to areas outside main city borders, but due to certain difficulties, it will be shipped to the closest courier company office. We would kindly ask you to pick up your order.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-2-do-you-have-extra-charges-for-delivery\" type=\"checkbox\" />\n                    <label for=\"accordion-2-do-you-have-extra-charges-for-delivery\">Do you have extra charges for delivery?</label>\n                    <div><p>Yes, delivery fees will be charged according to the country and with any method that will be used such as: Cash on Delivery, bank card or Apple Pay.<br /><br />Free Delivery is applied to paid orders only.*Cash on Delivery orders not included.<br /><br />Delivery fees are as follows:<br /><br />KSA: Below 369 SAR will have a surcharge of SAR 19 for delivery.<br /><br />UAE: All orders will have a surcharge of 40 AED for delivery.<br /><br />Kuwait: All order will have a surcharge of 3 KWD for delivery. <br /><br />Oman: No minimum cart amount, will have a surcharge of 10 OMR for delivery.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-3-how-long-does-it-take-for-my-order-to-be-delivered\" type=\"checkbox\" />\n                    <label for=\"accordion-3-how-long-does-it-take-for-my-order-to-be-delivered\">How long does it take for my order to be delivered?</label>\n                    <div><p>Order delivery on normal days:<br /><br />Kindly note that UAE, Kuwait, and Oman customers will receive their orders within 5-8 working days from the day their order is placed.<br /><br />KSA customers except in Riyadh, Jeddah, and Dammam will receive their orders within 1-3 working days from the day their order is placed.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-4-how-can-i-track-my-order\" type=\"checkbox\" />\n                    <label for=\"accordion-4-how-can-i-track-my-order\">How can I track my order?</label>\n                    <div><p>We will provide you with the tracking number at your Email address once your order been shipped<br />If your order has taken more than 5 days in KSA or 7 days in other countries, please contact the customer support team via the Contact us form, send an email at <a href=\"mailto:care@goldenscent.com\">care@goldenscent.com</a> or call us at:<br /><br />KSA: 920022386<br />Kuwait: +966133339238<br />UAE: +97148757600<br />and we will be happy to assist you.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-5-how-can-i-change-my-delivery-address\" type=\"checkbox\" />\n                    <label for=\"accordion-5-how-can-i-change-my-delivery-address\">How can I change my delivery address?</label>\n                    <div><p>You can send an email at <a href=\"mailto:care@goldenscent.com\">care@goldenscent.com</a> to notify us of your correct address. Also, the courier company will call you prior to delivery to confirm your shipping address or change it at that time.<br /><br />Please note, changes in the delivery address after purchasing might cause a delay in your shipment.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-6-what-is-the-difference-between-the-shipping-fees-and-cod-fees\" type=\"checkbox\" />\n                    <label for=\"accordion-6-what-is-the-difference-between-the-shipping-fees-and-cod-fees\">What is the difference between the shipping fees and COD fees?</label>\n                    <div><p>We at Goldenscent aim to provide the best services and expand the options to our customers, so we provide cash on delivery as a payment method, which entails additional costs from the shipping company:<br /><br />40 SAR For KSA<br /><br />40 AED for UAE<br /><br />You can cancel this value by prepaid by credit card, or apple pay<br /><br />Cash on delivery service is not available for Kuwait &amp; Oman.<br /><br />Shipping costs in Saudi Arabia are free for orders above 369 SAR, otherwise an additional cost of 19 SAR will be charged.<br /><br />Shipping costs will be calculated, if the total purchase value is less than 369 riyals after using the discount code.<br /><br />As for Kuwait, Oman and the UAE, there is no minimum cart value for free shipping. Shipping costs 3 KWD / 10 OMR / 30 AED on all orders.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-7-what-could-cause-delay-in-shipment\" type=\"checkbox\" />\n                    <label for=\"accordion-7-what-could-cause-delay-in-shipment\">What could cause delay in shipment?</label>\n                    <div><p>At Goldenscent we believe that delivery of the order must be done on time and any delay will be very frustrating, so we are working to deliver the shipment to the shipping companies within one business day, and for any delays from the shipping companies please know your order will be our responsibility, just contact us on<br /><br />KSA: 920022386<br /><br />Kuwait: +96613333923<br /><br />UAE: +97148757600<br /><br />or by sending an email at: care@goldenscent.com We will follow up the order and deliver it to your attendant as soon as possible.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-8-what-are-the-service-fees-and-why-were-they-added-to-my-order\" type=\"checkbox\" />\n                    <label for=\"accordion-8-what-are-the-service-fees-and-why-were-they-added-to-my-order\">What are the service fees and why were they added to my order?</label>\n                    <div><p>It is a service fee for orders less than 180 Saudi riyals or its equivalent in other currencies<br /><br />The value of this fee is 15 SAR. The purpose of this fee is to ensure that we continue to provide you with the best service.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-9-bullet-delivery\" type=\"checkbox\" />\n                    <label for=\"accordion-9-bullet-delivery\">Bullet Delivery</label>\n                    <div><p>1- The bullet delivery service is available in Riyadh - KSA only<br /><br />2- Bullet delivery is available for selected products.<br /><br />3- There will be an additional cost of 20 SAR for the service of bullet delivery (not included in the order price). If there is a delay from Golden Scent, the fee will be refunded to the customer. However, the fee is not refundable if the delay was caused by the customer, including not responding to the courier’s call.<br /><br />4- If the order is not delivered, it will be returned to Golden Scent warehouses and re-shipped with a shipping company. It will take 1-3 business days for delivery.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n                </div>\n            </div>\n        \n            <div class=\"block-wrapper\">\n                <div class=\"row\">\n                    <div class=\"col-xs-12\">\n                        <H2>Click & Collect (Redbox Lockers)</h2>\n                    </div>\n                    \n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-1-where-can-i-use-redbox-service\" type=\"checkbox\" />\n                    <label for=\"accordion-1-where-can-i-use-redbox-service\">Where can I use RedBox service?</label>\n                    <div><p>This service is only available in the Kingdom of Saudi Arabia.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-2-what-are-the-services-provided-by-redbox\" type=\"checkbox\" />\n                    <label for=\"accordion-2-what-are-the-services-provided-by-redbox\">What are the services provided by RedBox?</label>\n                    <div><p>RedBox provides the smart parcel lockers services to customers in the Kingdom of Saudi Arabia.<br /><br />Customers can receive and return their packages through RedBox parcel lockers within hundreds of RedBox Points around the city.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-3-why-choose-to-receive-orders-at-redbox-points-rather-than-home-delivery\" type=\"checkbox\" />\n                    <label for=\"accordion-3-why-choose-to-receive-orders-at-redbox-points-rather-than-home-delivery\">Why choose to receive orders at RedBox Points rather than home delivery?</label>\n                    <div><p>With RedBox, customers can pick up and return their packages through a RedBox Point that is near their home or workplace.<br /><br />It is more convenient and there is no need for time arrangements with delivery drivers.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-4-how-can-i-benefit-from-redbox-service-on-golden-scent\" type=\"checkbox\" />\n                    <label for=\"accordion-4-how-can-i-benefit-from-redbox-service-on-golden-scent\">How can I benefit from RedBox service on Golden Scent?</label>\n                    <div><p>A. Click on “Add New Address”<br /><br />B. You will see all the RedBox Points destinations available in your area as well as important information such as the exact address, timings, etc.<br /><br />C. Choose the most convenient location for you.<br /><br />Once the address is registered in your address book, you can select that address during the checkout process and complete your order as normal.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-5-how-can-i-pick-up-my-packages-from-redbox-lockers\" type=\"checkbox\" />\n                    <label for=\"accordion-5-how-can-i-pick-up-my-packages-from-redbox-lockers\">How can I pick up my packages from RedBox Lockers?</label>\n                    <div><p>Once your package gets deposited into the RedBox locker, you will receive an SMS with a PIN CODE and a tracking link.<br /><br />You can go to the selected RedBox Locker then enter the PIN CODE, or scan the QR code.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-6-how-long-will-the-package-stay-in-the-redbox-locker\" type=\"checkbox\" />\n                    <label for=\"accordion-6-how-long-will-the-package-stay-in-the-redbox-locker\">How long will the package stay in the RedBox locker?</label>\n                    <div><p>Customers will have up to 48 hours to pick up their packages.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-7-where-are-redbox-points-located\" type=\"checkbox\" />\n                    <label for=\"accordion-7-where-are-redbox-points-located\">Where are RedBox Points located?</label>\n                    <div><p>RedBox Points are located in many venues around the city, such as: supermarkets, shopping malls, and residential compounds. You can check the Lockers map <a href=\"https://redboxsa.com/en/map/\" target=\"_blank\">here</a></p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-8-what-happens-if-i-do-not-pick-up-my-package-within-48-hrs\" type=\"checkbox\" />\n                    <label for=\"accordion-8-what-happens-if-i-do-not-pick-up-my-package-within-48-hrs\">What happens if I do not pick up my package within 48 hrs?</label>\n                    <div><p>You can extend the period to receive the shipment through the shipment tracking link or by contacting Red Box customer service.<br /><br />A small fee will be charged for this service.<br /><br />In the event that the period is not extended in advance, the Red Box team will return the shipment to our warehouse.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-9-what-should-i-do-if-i-find-a-different-package-than-the-one-i-ordered\" type=\"checkbox\" />\n                    <label for=\"accordion-9-what-should-i-do-if-i-find-a-different-package-than-the-one-i-ordered\">What should I do if I find a different package than the one I ordered?</label>\n                    <div><p>We apologize for the inconvenience! Please contact Golden Scent customer support team and we will help you immediately.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-10-can-i-pay-cash-for-my-orders-at-redbox-points-cash-on-delivery\" type=\"checkbox\" />\n                    <label for=\"accordion-10-can-i-pay-cash-for-my-orders-at-redbox-points-cash-on-delivery\">Can I pay cash for my orders at RedBox Points (cash on delivery)?</label>\n                    <div><p>At RedBox Points, we only accept electronic payments (MADA, Credit Cards, Apple Pay). We do NOT accept cash.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-11-can-i-return-packages-using-redbox-points\" type=\"checkbox\" />\n                    <label for=\"accordion-11-can-i-return-packages-using-redbox-points\">Can I return packages using RedBox Points?</label>\n                    <div><p>Yes. Return services are allowed for selected partners.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-12-how-can-i-return-packages-through-redbox-points\" type=\"checkbox\" />\n                    <label for=\"accordion-12-how-can-i-return-packages-through-redbox-points\">How can I return packages through RedBox Points?</label>\n                    <div><p>After contacting Golden Scent customer support, you will receive an SMS with a return PIN CODE.<br /><br />Go to the nearest RedBox Locker and click “Package Returns” then enter the received PIN CODE.<br /><br />Please stick the printed return label on your package and deposit it into the opened bin.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-13-should-i-sign-up-online-to-receive-my-packages-through-redbox-lockers\" type=\"checkbox\" />\n                    <label for=\"accordion-13-should-i-sign-up-online-to-receive-my-packages-through-redbox-lockers\">Should I sign up online to receive my packages through RedBox lockers?</label>\n                    <div><p>No. You only have to choose the “RedBox Locker” service as your shipping method on the checkout page.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-14-can-someone-else-pick-up-the-package\" type=\"checkbox\" />\n                    <label for=\"accordion-14-can-someone-else-pick-up-the-package\">Can someone else pick up the package?</label>\n                    <div><p>We advise you to pick up the package yourself. However, anyone with the PIN CODE can pick up the package at any time.<br /><br />RedBox will not be responsible for theft or any stolen packages in this case.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-15-what-should-i-do-if-the-locker-door-did-not-open-after-entering-the-pin-code\" type=\"checkbox\" />\n                    <label for=\"accordion-15-what-should-i-do-if-the-locker-door-did-not-open-after-entering-the-pin-code\">What should I do if the locker door did not open after entering the PIN CODE?</label>\n                    <div><p>We apologize for the inconvenience! Please call 920033259 and one of our support team members will help you immediately.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-16-can-i-switch-between-redbox-service-to-delivery-and-vice-versa\" type=\"checkbox\" />\n                    <label for=\"accordion-16-can-i-switch-between-redbox-service-to-delivery-and-vice-versa\">Can I switch between RedBox service to delivery and vice versa?</label>\n                    <div><p>Once you choose RedBox as your shipment delivery address, you will not be able to change it to your home or office address.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n                </div>\n            </div>\n        \n            <div class=\"block-wrapper\">\n                <div class=\"row\">\n                    <div class=\"col-xs-12\">\n                        <H2>Click & Collect (FODEL)</h2>\n                    </div>\n                    \n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-1-what-is-fodel\" type=\"checkbox\" />\n                    <label for=\"accordion-1-what-is-fodel\">What is FODEL?</label>\n                    <div><p>FODEL offers an alternative to home delivery. Shoppers now have the possibility to pick up their parcels from their local merchants at a time that suits them best.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-2-who-is-fodel-for\" type=\"checkbox\" />\n                    <label for=\"accordion-2-who-is-fodel-for\">Who is FODEL for?</label>\n                    <div><p>FODEL is for busy online shoppers that do not have the time to wait all day for a parcel to be delivered.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-3-how-will-i-know-that-my-parcel-is-ready-for-collection\" type=\"checkbox\" />\n                    <label for=\"accordion-3-how-will-i-know-that-my-parcel-is-ready-for-collection\">How will I know that my parcel is ready for collection?</label>\n                    <div><p>You will receive an email and a text message confirmation with your pick-up location and your unique parcel validation code.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-4-how-do-i-find-the-opening-hours-of-my-fodel-pick-up-location\" type=\"checkbox\" />\n                    <label for=\"accordion-4-how-do-i-find-the-opening-hours-of-my-fodel-pick-up-location\">How do I find the opening hours of my FODEL pick-up location?</label>\n                    <div><p>The opening times of your pick-up locations will be on your unique validation code sent by email and text message.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-5-how-do-i-collect-my-parcel-from-a-fodel-pick-up-location\" type=\"checkbox\" />\n                    <label for=\"accordion-5-how-do-i-collect-my-parcel-from-a-fodel-pick-up-location\">How do I collect my parcel from a FODEL pick-up location?</label>\n                    <div><p>You simply present a valid form of ID and your unique parcel validation code to FODEL pick-up location’s cashier.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-6-can-someone-else-collect-my-parcel-for-me\" type=\"checkbox\" />\n                    <label for=\"accordion-6-can-someone-else-collect-my-parcel-for-me\">Can someone else collect my parcel for me?</label>\n                    <div><p>Yes, they will be able to collect your parcel as long as they present a valid form of ID and your unique parcel validation code to the store cashier.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-7-how-long-do-i-have-to-collect-my-parcel-from-a-fodel-pick-up-location\" type=\"checkbox\" />\n                    <label for=\"accordion-7-how-long-do-i-have-to-collect-my-parcel-from-a-fodel-pick-up-location\">How long do I have to collect my parcel from a FODEL pick-up location?</label>\n                    <div><p>You have five (5) days to collect your parcel otherwise, it will be returned to the courier or to the sender of your parcel.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-8-can-i-pay-with-a-credit-card-while-receiving-my-package-when-choosing-cash-on-delivery\" type=\"checkbox\" />\n                    <label for=\"accordion-8-can-i-pay-with-a-credit-card-while-receiving-my-package-when-choosing-cash-on-delivery\">Can I pay with a credit card while receiving my package when choosing Cash on Delivery?</label>\n                    <div><p>Most of FODEL’s pick-up locations accept card payments. In the rare eventuality that a specific pick-up location only accepts cash payments, your email and text message confirmation containing your unique parcel validation code will also mention the amount of cash you need to bring to your pick-up location.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-9-what-should-i-do-if-my-parcel-was-lost-stolen-or-damaged-at-my-fodel-pick-up-location\" type=\"checkbox\" />\n                    <label for=\"accordion-9-what-should-i-do-if-my-parcel-was-lost-stolen-or-damaged-at-my-fodel-pick-up-location\">What should I do if my parcel was lost, stolen, or damaged at my FODEL pick-up location?</label>\n                    <div><p>FODEL pick-up locations are equipped with surveillance equipment for your parcels. If a parcel is lost, stolen, or damaged please get in touch with us and we will take the necessary action.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-10-how-can-i-benefit-from-fodel-service-on-golden-scent\" type=\"checkbox\" />\n                    <label for=\"accordion-10-how-can-i-benefit-from-fodel-service-on-golden-scent\">How can I benefit from FODEL service on Golden Scent?</label>\n                    <div><p>A. Click on “Add New Address”<br /><br />B. You will see all FODEL pick-up locations available in your area as well as important information such as the exact address, timings, etc.<br /><br />C. Choose the most convenient location for you.<br /><br />Once the address is registered in your address book, you can select that address during the checkout process and complete your order as normal.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-11-where-are-fodel-pick-up-locations\" type=\"checkbox\" />\n                    <label for=\"accordion-11-where-are-fodel-pick-up-locations\">Where are FODEL pick-up locations?</label>\n                    <div><p>FODEL pick-up locations can be found in many venues around KSA, such as: supermarkets, shopping malls, and residential compounds.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-12-can-i-return-packages-using-fodel-pick-up-locations\" type=\"checkbox\" />\n                    <label for=\"accordion-12-can-i-return-packages-using-fodel-pick-up-locations\">Can I return packages using FODEL pick-up locations?</label>\n                    <div><p>The return service through Foodel is not available, the customer service team will provide the appropriate return method for you through one of our partners</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-13-where-can-i-use-fodel-service\" type=\"checkbox\" />\n                    <label for=\"accordion-13-where-can-i-use-fodel-service\">Where can I use FODEL service?</label>\n                    <div><p>This service is only available in the Kingdom of Saudi Arabia.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"col-xs-12 col-md-4\">\n        <div class=\"data-block\">\n            <ul class=\"jekyllcodex_accordion\">\n                <li>\n                    <input id=\"accordion-14-can-i-switch-from-fodel-service-to-home-delivery-and-vice-versa\" type=\"checkbox\" />\n                    <label for=\"accordion-14-can-i-switch-from-fodel-service-to-home-delivery-and-vice-versa\">Can I switch from FODEL service to home delivery and vice versa?</label>\n                    <div><p>Once you choose FODEL service as your shipment delivery address, you will not be able to change it to your home or office address.</p>\n</div>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n                </div>\n            </div>\n        \n    </div>\n</div>\n</body>\n</html>\n<!--\npath:en/faqs/delivery.html\nlang:en\nlayout:faqs\n-->\n<script type=\"text/javascript\">\n  document.addEventListener('DOMContentLoaded', function() {\n\n    let source = localStorage.getItem(\"source\");\n    if(source) {\n      document.getElementsByClassName('logoc')[0].style.display = \"none\";\n      document.getElementsByClassName('navigation-wrapper-mobile')[0].style.display = \"none\";\n      return\n    }\n\n    if(window.location.href.includes('source=app')) {\n\n      localStorage.setItem(\"source\", \"app\");\n\n      document.getElementsByClassName('logoc')[0].style.display = \"none\";\n      document.getElementsByClassName('navigation-wrapper-mobile')[0].style.display = \"none\";\n    }\n  }, false);\n</script>\n",
